{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "environment": "preview",
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
