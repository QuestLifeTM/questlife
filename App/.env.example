# Public Supabase configuration for local Expo development.
# These values are bundled into the client; never put service-role or other secret keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A Sentry DSN identifies the error-ingest project and is safe to embed in a client.
# Leave blank to keep Sentry disabled locally.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
